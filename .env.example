DATABASE_URL=
MZJ_SETUP_KEY=
MZJ_GATEWAY_SECRET=
AUTOMATION_SCHEDULER_URL=
AUTOMATION_SCHEDULER_SECRET=

# Private Cloudflare R2 storage for CRM images, voice notes, video and documents.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# WhatsApp / Mersal token stays inside Cloudflare Worker, never in Vercel.
# Sending and template synchronization routes are read from CRM > Endpoints / Workers.

# Tracking orders integration from Google Apps Script. Optional; when set, send it as x-mzj-tracking-key.
TRACKING_INGEST_KEY=

# Direct ERPNext Sales Order webhook. Send the same value in the X-MZJ-ERPNext-Key header.
# If left empty, the endpoint falls back to TRACKING_INGEST_KEY.
ERPNEXT_WEBHOOK_KEY=
TRACKING_PUBLIC_BASE_URL=https://mzj-platform.vercel.app

# Firebase is used only for SMS+ queue documents in sms_outbox.
FIREBASE_PROJECT_ID=mzj-tracking
FIREBASE_API_KEY=
# Recommended secure server-side credentials (choose JSON or the two split variables).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Marketing platform connections (OAuth only; no manual tokens).
# Public HTTPS origin used to build OAuth callback URLs.
MZJ_PUBLIC_BASE_URL=https://mzj-platform.vercel.app
# Required in production. Use a random secret of at least 32 characters.
MZJ_PLATFORM_TOKEN_ENCRYPTION_KEY=

# Meta / Facebook Pages / Instagram Professional.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration ID. The OAuth dialog uses config_id instead of scope.
META_CONFIG_ID=
META_REDIRECT_URI=https://mzj-platform.vercel.app/api/marketing/platform-connections/callback/meta
META_GRAPH_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=change-this-to-a-long-random-value
META_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_read_user_content,pages_manage_posts,pages_manage_metadata,instagram_basic,instagram_content_publish,instagram_manage_comments,instagram_manage_insights

# TikTok Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://mzj-platform.vercel.app/api/marketing/platform-connections/callback/tiktok
TIKTOK_SCOPES=user.info.basic,video.upload,video.publish

# Google OAuth / YouTube Data API v3.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=https://mzj-platform.vercel.app/api/marketing/platform-connections/callback/youtube
YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube.readonly

# Existing RAW folders server integration used by campaigns and agendas.
MZJ_RAW_API_URL=
MZJ_RAW_API_TOKEN=

# Zoho WorkDrive final publishing files (Saudi data center).
# Final-file bytes upload directly from the authorized user browser to Zoho; Vercel only prepares and confirms the upload.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCOUNT_EMAIL=marketing@mzjcars.com
ZOHO_ACCOUNTS_URL=https://accounts.zoho.sa
ZOHO_API_DOMAIN=https://www.zohoapis.sa
ZOHO_UPLOAD_DOMAIN=https://files.zoho.sa
ZOHO_REDIRECT_URI=https://mzj-platform.vercel.app/api/integrations/zoho/callback
ZOHO_PUBLISH_ROOT_FOLDER_ID=efosi67f34a771f13446c8d01545192eb1829

# Set false after MZJ_RAW_API_TOKEN is explicitly configured.
# The default keeps compatibility with the existing RAW server during migration.
MZJ_RAW_ALLOW_LEGACY_TOKEN=true

# HMAC secret for MZJ Owners Community OTP challenges
OWNERS_OTP_SECRET=

# Read-only MZJ Cars inventory bridge used by Website > stock and Owners discount calculator.
MZJ_CARS_BRIDGE_URL=https://mzjcars.com/wp-json/mzj-platform/v2/cars
MZJ_CARS_BRIDGE_SECRET=

# MZJ Club: secure server-side lookup/download of Sales Invoices linked to Sales Orders in NEXT ERP.
# Use a read-only ERP API user when possible. These values stay in Vercel/server environment only.
NEXT_ERP_URL=https://mzj2.newworldinfosys.com
NEXT_API_KEY=
NEXT_API_SECRET=
# Optional. Defaults to Standard when empty.
NEXT_ERP_SALES_INVOICE_PRINT_FORMAT=Standard
